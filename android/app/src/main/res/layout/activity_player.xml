<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/black" android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView android:id="@+id/player" android:layout_width="match_parent" android:layout_height="match_parent"
        app:show_buffering="always" app:show_subtitle_button="true" />

    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top"
        android:padding="24dp" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:shadowColor="#CC000000" android:shadowRadius="8" />

    <TextView android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start"
        android:layout_margin="24dp" android:background="@color/hf_violet" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp"
        android:text="Coming up" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />

    <!-- What a gesture changed: brightness, volume, or how far a double-tap skipped. -->
    <TextView android:id="@+id/hud" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
        android:layout_margin="56dp" android:background="@drawable/hud" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="12dp" android:paddingBottom="12dp"
        android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:visibility="gone" />

    <LinearLayout android:id="@+id/message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end"
        android:layout_margin="32dp" android:background="#EE141127" android:orientation="vertical" android:padding="20dp" android:visibility="gone">
        <TextView android:id="@+id/message_small" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/hf_cyan" android:textSize="13sp" />
        <TextView android:id="@+id/message_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="4dp" />
        <Button android:id="@+id/message_button" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="14dp" android:background="@drawable/button"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:textAllCaps="false" android:textColor="@color/hf_bg" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
