<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/hf_bg">

    <WebView android:id="@+id/web" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="invisible" />

    <!-- Splash while HallFlix loads -->
    <ImageView android:id="@+id/splash" android:layout_width="260dp" android:layout_height="wrap_content" android:layout_gravity="center"
        android:adjustViewBounds="true" android:src="@drawable/logo" android:contentDescription="@string/app_name" />

    <!-- First run, and whenever the server cannot be reached -->
    <ScrollView android:id="@+id/panel" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:gravity="center" android:padding="32dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_gravity="center" android:gravity="center_horizontal">
                <ImageView android:layout_width="200dp" android:layout_height="wrap_content" android:adjustViewBounds="true"
                    android:src="@drawable/logo" android:layout_marginBottom="24dp" android:contentDescription="@string/app_name" />
                <TextView android:id="@+id/panel_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="24sp" android:textStyle="bold" android:textColor="@color/hf_text" android:gravity="center" />
                <TextView android:id="@+id/panel_text" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="15sp" android:textColor="@color/hf_muted" android:gravity="center" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" />
                <EditText android:id="@+id/server" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/field"
                    android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/hf_text" android:textColorHint="@color/hf_muted"
                    android:hint="https://new.hallflix.net" android:inputType="textUri" android:imeOptions="actionGo" android:singleLine="true" android:textSize="18sp" />
                <Button android:id="@+id/connect" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="14dp"
                    android:background="@drawable/button" android:textColor="@color/hf_bg" android:textSize="17sp" android:textStyle="bold" android:textAllCaps="false" android:text="Connect" />
                <Button android:id="@+id/retry" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:visibility="gone"
                    android:background="@drawable/button_quiet" android:textColor="@color/hf_text" android:textSize="16sp" android:textAllCaps="false" android:text="Try again" />
                <!-- With no connection, what's been downloaded still plays. -->
                <Button android:id="@+id/offline" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp" android:visibility="gone"
                    android:background="@drawable/button_quiet" android:textColor="@color/hf_text" android:textSize="16sp" android:textAllCaps="false" android:text="My downloads" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
